# NewsClaw AI 动态内容运营环境变量
#
# 用法：cp .env.example .env && chmod 600 .env
# .env 已被 .gitignore 忽略，禁止提交真实密钥。
#
# 配置优先级（仅对支持环境覆盖的字段）：
#   非空环境变量 > 数据库/UI 配置 > 应用默认值
#
# 模型 Provider、搜索、公众号和国内 IM 的 Key 都可以在这里配置。
# 不填某项时继续使用数据库/UI 中已有的值；因此升级旧部署不会丢配置。
#
# AI 动态内容运营主线的配置判断：
# - 至少填写一家 LLM Provider 的 API Key（推荐 DASHSCOPE_API_KEY/BAILIAN_API_KEY 或 DEEPSEEK_API_KEY）。
# - Serper/Tavily 是搜索增强 Key，不是硬性必需；内置 SearXNG 可无 Key 工作并支持回退。
# - 公众号草稿箱需要 WEIXINOA_APP_ID + WEIXINOA_APP_SECRET。
# - 国内 IM 按实际启用的一个渠道填写凭证（飞书、钉钉或企业微信任选其一）。
# - 小红书只生成预览和素材 ZIP，当前不需要官方发布 API Key。
# 为保持部署兼容性，环境变量继续使用 NEWSCLAW_ 技术前缀。
# NEWSCLAW_ENV_CONFIG_ENABLED=false 可临时关闭所有环境覆盖。

NEWSCLAW_ENV_CONFIG_ENABLED=true
NEWSCLAW_PRODUCTION_MODE=true
NEWSCLAW_SETUP_ALLOW_ANONYMOUS=false
NEWSCLAW_SCREENSHOT_ENABLED=false
NEWSCLAW_AI_NEWS_REQUIRE_EVENT_CONTEXT=true
NEWSCLAW_AI_NEWS_STRICT_EVIDENCE_BOUNDARY=true
NEWSCLAW_EXTERNAL_PUBLISH_ENABLED=false
NEWSCLAW_WEBCHAT_PUBLIC_ENABLED=false
# Fresh production installs rotate the legacy seed with this one-time secret;
# it must be 32-72 UTF-8 bytes. Generate with: openssl rand -base64 36,
# then remove it after changing password.
NEWSCLAW_BOOTSTRAP_PASSWORD=replace-with-a-random-one-time-bootstrap-password

# Compose 强制将应用与桌面回调端口绑定到回环地址；公网只走 HTTPS 443。
NEWSCLAW_HTTP_PORT=18080
NEWSCLAW_DESKTOP_PORT=1455
NEWSCLAW_SERVER_MEMORY_LIMIT=4g
NEWSCLAW_SERVER_CPUS=4.0
NEWSCLAW_SERVER_PIDS_LIMIT=1024
# For a frozen release use the local digest-tagged image with --no-build.
NEWSCLAW_SERVER_IMAGE=newsclaw-server:local

# ==================== PostgreSQL（Docker 必填） ====================
# Compose 内部会把 DB_HOST 改为 newsclaw-postgres；宿主机直接运行时使用 localhost。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newsclaw
DB_USERNAME=newsclaw
DB_PASSWORD=change-me-strong-user-password
DB_ADMIN_USERNAME=newsclaw_admin
DB_ADMIN_PASSWORD=change-me-strong-admin-password

# ==================== Flyway 迁移完整性 ====================
# 默认不在应用启动时 repair（repair 会重写 checksum / 清理失败记录）。
# 仅在审查并备份后做一次性恢复时临时设为 true，完成后恢复 false。
NEWSCLAW_FLYWAY_AUTO_REPAIR=false
# PostgreSQL / Kingbase 默认开启 checksum 校验；仅用于受控兼容窗口。
NEWSCLAW_FLYWAY_VALIDATE_ON_MIGRATE=true

# ==================== 安全与密钥加密 ====================
# 至少 32 字符：openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret
# AES-GCM 加密 mate_system_setting 中的敏感值；必须长期保存，丢失后需重填密钥。
NEWSCLAW_SETTING_KEY=replace-with-a-long-random-setting-key
# AES 加密 Skill Secret 与数据源密码；独立于上面的 AES-GCM 设置密钥，也必须长期保存。
NEWSCLAW_ENCRYPT_KEY=replace-with-a-long-random-encrypt-key
# SearXNG sidecar 会话密钥：openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-long-random-searxng-secret
NEWSCLAW_CORS_ALLOWED_ORIGINS=
# Set to the real HTTPS domain only when external artifact links are needed.
NEWSCLAW_PUBLIC_BASE_URL=
NEWSCLAW_OPENAPI_EXPOSE_UI=false
# Public WebChat cost/DoS guards (per channel API key).
NEWSCLAW_WEBCHAT_MAX_CONCURRENT_STREAMS_PER_KEY=4
NEWSCLAW_WEBCHAT_REQUESTS_PER_MINUTE_PER_KEY=30
NEWSCLAW_WEBCHAT_MAX_MESSAGE_CHARS=16000

# ==================== OpenTelemetry 指标（可选） ====================
# 默认关闭；启用后通过 OTLP/HTTP 上报 Micrometer 指标，不在 metric label 中写入 URL/正文。
NEWSCLAW_OTLP_METRICS_ENABLED=false
NEWSCLAW_OTLP_METRICS_URL=http://otel-collector:4318/v1/metrics
NEWSCLAW_OTLP_METRICS_STEP=60s
NEWSCLAW_OTLP_METRICS_CONNECT_TIMEOUT=3s
NEWSCLAW_OTLP_METRICS_READ_TIMEOUT=10s

# ==================== AI 动态检索 ====================
# 云搜索 Key 可选；未配置时自动使用/回退到 Compose 内置 SearXNG。
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev/search
# Tavily 号池：推荐使用逗号分隔；也接受空格、分号或换行（UI 中可每行一个）。
TAVILY_API_KEYS=
# 旧版单 Key 配置，只有 TAVILY_API_KEYS 为空时才会使用。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search
NEWSCLAW_SEARCH_PROVIDER=serper
NEWSCLAW_SEARCH_ENABLED=true
NEWSCLAW_SEARCH_FALLBACK_ENABLED=true
NEWSCLAW_DUCKDUCKGO_ENABLED=true
SEARXNG_BASE_URL=http://newsclaw-searxng:8080
# 可选 RSS/Atom 号源，逗号分隔。只配置已审核许可、长期稳定的 feed；
# 例：NEWSCLAW_AI_NEWS_RSS_FEEDS=https://publisher.example/ai.xml,https://vendor.example/news.rss
NEWSCLAW_AI_NEWS_RSS_FEEDS=
# 可选 Google News Sitemap / sitemap index，逗号分隔；同样需要逐来源审核。
# 例：NEWSCLAW_AI_NEWS_SITEMAPS=https://publisher.example/news-sitemap.xml
NEWSCLAW_AI_NEWS_SITEMAPS=
# 启用 source_catalog.yml 中已完成部署方审核的 endpoint id；未知 id 会拒绝启动。
NEWSCLAW_AI_NEWS_SOURCE_ENDPOINT_IDS=
# 结构化来源由独立调度器写入持久化账本；请求默认只读账本，不临时访问发布方。
NEWSCLAW_AI_NEWS_INGESTION_ENABLED=true
NEWSCLAW_AI_NEWS_INGESTION_SCAN_INTERVAL_MS=60000
NEWSCLAW_AI_NEWS_INGESTION_INITIAL_DELAY_MS=15000
NEWSCLAW_AI_NEWS_INGESTION_ON_DEMAND_REFRESH_IF_EMPTY=false
NEWSCLAW_AI_NEWS_INGESTION_MAX_POLLS_PER_CYCLE=50
NEWSCLAW_AI_NEWS_INGESTION_STALE_RUN_MINUTES=30
NEWSCLAW_AI_NEWS_INGESTION_CANDIDATE_LOOKBACK_DAYS=31
# V213 候选流水线与外部正文抓取均默认关闭，先用于 shadow/dual-run。
# 逗号分隔的全球检索 provider id；有 Tavily Key 池时推荐显式填写 tavily，
# 避免运行时根据其他通用搜索配置自动选择 provider。
NEWSCLAW_AI_NEWS_DISCOVERY_PROVIDER_IDS=
NEWSCLAW_AI_NEWS_CANDIDATE_PIPELINE_ENABLED=false
NEWSCLAW_AI_NEWS_CANDIDATE_CAPTURE_ENABLED=false
NEWSCLAW_AI_NEWS_CANDIDATE_SCAN_INTERVAL_MS=900000
NEWSCLAW_AI_NEWS_CANDIDATE_CAPTURE_INTERVAL_MS=60000
NEWSCLAW_AI_NEWS_CANDIDATE_INITIAL_DELAY_MS=60000
NEWSCLAW_AI_NEWS_CANDIDATE_WORKSPACE_ID=1
NEWSCLAW_AI_NEWS_CANDIDATE_LOOKBACK_HOURS=24
NEWSCLAW_AI_NEWS_CANDIDATE_MAX_CANDIDATES=30
NEWSCLAW_AI_NEWS_CANDIDATE_MAX_CAPTURES_PER_SCAN=10
NEWSCLAW_AI_NEWS_CANDIDATE_MAX_CAPTURE_ATTEMPTS=3
NEWSCLAW_AI_NEWS_CANDIDATE_CAPTURE_RETRY_MINUTES=15
NEWSCLAW_AI_NEWS_CANDIDATE_STALE_CAPTURE_MINUTES=30
NEWSCLAW_AI_NEWS_CANDIDATE_STALE_RUN_MINUTES=120
NEWSCLAW_AI_NEWS_CANDIDATE_RETENTION_DAYS=90
NEWSCLAW_AI_NEWS_CAPTURE_RETENTION_DAYS=30
NEWSCLAW_AI_NEWS_RETENTION_BATCH_SIZE=100
NEWSCLAW_AI_NEWS_CANDIDATE_CONFIG_VERSION=candidate-pipeline-v2-bocha
# 博查 Web Search（provider id: bocha-web）使用独立凭证；真实 Key 只写部署 .env，
# 不复用任何模型或视频生成 Key，也不要提交到模板或版本库。
NEWSCLAW_AI_NEWS_CHINA_SEARCH_ENABLED=false
NEWSCLAW_AI_NEWS_CHINA_SEARCH_API_KEY=
NEWSCLAW_AI_NEWS_CHINA_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
NEWSCLAW_AI_NEWS_CHINA_SEARCH_COUNT=20
NEWSCLAW_AI_NEWS_CHINA_SEARCH_TIMEOUT_SECONDS=15
# 发现精度门禁：允许不足 Top-K，避免单一 host、同一事件和未知时间页面挤满抓取队列。
NEWSCLAW_AI_NEWS_DISCOVERY_MAX_CANDIDATES_PER_HOST=4
NEWSCLAW_AI_NEWS_DISCOVERY_MAX_CANDIDATES_PER_STORY=2
NEWSCLAW_AI_NEWS_DISCOVERY_CURRENT_OPEN_WEB_PERCENT=20
NEWSCLAW_AI_NEWS_DISCOVERY_MAX_UNKNOWN_PERCENT=0
NEWSCLAW_AI_NEWS_DISCOVERY_UNKNOWN_OFFICIAL_PERCENT=20
NEWSCLAW_AI_NEWS_DISCOVERY_UNKNOWN_MEDIA_PERCENT=20
NEWSCLAW_AI_NEWS_DISCOVERY_UNKNOWN_OPEN_WEB_PERCENT=0
# Enables the provenance-preserving AI-news source adapter to reach the fixed
# Compose sidecar. Keep false for a public SearXNG endpoint.
NEWSCLAW_AI_NEWS_SEARXNG_ALLOW_PRIVATE_ENDPOINT=true
# GitHub Release / 开源项目动态抓取（可选，降低匿名 API 限流）。
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
# 远程 MCP Header 模板可引用的可选 Bearer 值。
MCP_API_KEY=

# ==================== LLM 模型提供商密钥与端点 ====================
# 环境变量只覆盖对应模型提供商的 api_key/base_url，不会把 Key 回写数据库。
# 模型选择也可以完全由下面的链路变量控制；启动时会自动补齐缺失的模型目录行。

# ==================== 运行时模型选择与故障切换 ====================
# 首选模型。首选 Provider 发生超时、限流或鉴权失败时，按备用链顺序重试。
# 当前 AI 动态内容运营推荐：百炼 qwen3.7-plus -> DeepSeek deepseek-v4-flash。
# 留空则沿用数据库/UI 的全局默认模型。
NEWSCLAW_PRIMARY_MODEL_PROVIDER=bailian-team
NEWSCLAW_PRIMARY_MODEL=qwen3.7-plus
# 逗号分隔，格式为 provider::model；可填写多个备用模型。
NEWSCLAW_FALLBACK_MODEL_CHAIN=deepseek::deepseek-v4-flash
# 也可以用一行写完整链路（首项为首选），与上面显式变量二选一。
NEWSCLAW_MODEL_CHAIN=
# 示例：NEWSCLAW_MODEL_CHAIN=bailian-team::qwen3.7-plus,deepseek::deepseek-v4-flash

# ==================== AI 动态雷达调度 ====================
# 每日 08:00 雷达只在候选主线显式开启、凭证/模型链和国内 IM 齐备时启用。
# candidate=false 时旧 ai_news_event 仅可手动调用，不会被定时任务静默回退。
# 周报生产 Cron 永远不会由 seed 自动启用，必须由用户确认后启动 Team Run。
NEWSCLAW_AI_NEWS_RADAR_ENABLED=true

# ==================== 官方来源只读核验 ====================
# 仅使用无 Cookie、无登录态的 GET 请求抓取官方页面；每次重定向都执行 SSRF 校验。
# 此操作只归档可审计证据，不会自动将事件标记为 verified。
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_ENABLED=true
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_MAX_BYTES=1048576
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_MIN_TEXT_CHARS=200
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_TIMEOUT_SECONDS=15
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_MAX_REDIRECTS=5
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_MAX_ATTEMPTS=2
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_RETRY_BASE_DELAY_MILLIS=250
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_RETRY_MAX_DELAY_MILLIS=5000
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_REUSE_TTL_MINUTES=360
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_RATE_PER_MINUTE=30
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_MAX_CONCURRENT=2
# Optional credential-free HTTP proxy used only after a direct transport failure.
NEWSCLAW_AI_NEWS_OFFICIAL_CAPTURE_PROXY_URL=
# 成熟正文抽取（Compose 默认启用并 fail-closed）。抽取器只接收 Java 后端已抓取的 HTML，
# 不自行访问来源 URL。单 JAR 部署需自行运行同协议服务或显式关闭。
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_ENABLED=true
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_REQUIRED=true
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_ENDPOINT=http://newsclaw-content-extractor:8090
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_EXPECTED_NAME=trafilatura
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_EXPECTED_VERSION=2.2.0
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_EXPECTED_CONFIG_HASH=0235b7bf49c3c80ea6a52aee9f413fa2d4e4e1f5196af87278c48e558c7d0400
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_TIMEOUT_MILLIS=5000
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_MAX_REQUEST_BYTES=1048576
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_MAX_RESPONSE_BYTES=1572864
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_MAX_OUTPUT_CHARS=1048576
NEWSCLAW_AI_NEWS_CONTENT_EXTRACTION_MAX_CONCURRENCY=4

# ==================== AI 动态事件聚类 ====================
# 有界在线聚类默认启用；低置信候选只进入人工复核队列，不会自动合并。
# 这些初始门槛来自冻结开发集的保守配置，生产调整前应先运行聚类重放评测，
# 并在 P0-E 时间切分真实领域金标上重新校准。
NEWSCLAW_AI_NEWS_CLUSTERING_ENABLED=true
NEWSCLAW_AI_NEWS_CLUSTERING_MAX_CANDIDATES=300
NEWSCLAW_AI_NEWS_CLUSTERING_MAX_CANDIDATE_AGE_HOURS=168
NEWSCLAW_AI_NEWS_CLUSTERING_MIN_TITLE_BLOCKING_SIMILARITY=0.12
NEWSCLAW_AI_NEWS_CLUSTERING_AUTO_LINK_THRESHOLD=0.80
NEWSCLAW_AI_NEWS_CLUSTERING_REVIEW_THRESHOLD=0.62
NEWSCLAW_AI_NEWS_CLUSTERING_MIN_AUTO_TITLE_SIMILARITY=0.45

# 阿里云百炼 / 通义千问
# BAILIAN_API_KEY 可作为 dashscope / bailian-team 的密钥别名；
# BAILIAN_BASE_URL 只覆盖 bailian/bailian-team，dashscope 原生端点请配 DASHSCOPE_BASE_URL，
# 兼容模式请配 DASHSCOPE_COMPAT_BASE_URL。Provider 行仍需在 UI/seed 中选择匹配的 provider。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_COMPAT_BASE_URL=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
ALIYUN_BAILIAN_BASE_URL=
MODELSCOPE_BASE_URL=
MODELSCOPE_API_KEY=
MODELSCOPE_API_TOKEN=
ALIYUN_CODINGPLAN_API_KEY=
ALIYUN_CODINGPLAN_BASE_URL=
ALIYUN_CODINGPLAN_INTL_BASE_URL=

# OpenAI 及兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# Azure Provider 行使用 OpenAI 兼容端点；以下两个变量任选其一即可。
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=

# DeepSeek / Anthropic / Gemini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_IMAGEN_API_KEY=
GEMINI_BASE_URL=
GOOGLE_BASE_URL=

# Kimi / Moonshot
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
KIMI_API_KEY=
KIMI_API_KEY_CN=
KIMI_API_KEY_INTL=
KIMI_CODE_API_KEY=

# 国内模型与聚合网关
ZHIPU_API_KEY=
GLM_API_KEY=
ZHIPU_BASE_URL=
VOLCENGINE_API_KEY=
ARK_API_KEY=
VOLCENGINE_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_BASE_URL_CN=
SILICONFLOW_BASE_URL_INTL=
MINIMAX_API_KEY=
MINIMAX_API_KEY_CN=
MINIMAX_API_KEY_INTL=
MINIMAX_BASE_URL=
MINIMAX_BASE_URL_CN=
MINIMAX_BASE_URL_INTL=
XAI_API_KEY=
XAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=
TENCENT_API_KEY=
TENCENTCLOUD_BASE_URL=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
XIAOMI_API_KEY=
XIAOMI_BASE_URL=
MIMO_API_KEY=
MIMO_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=

# 任意自定义 provider 的通用写法（provider id 转大写并将 -/. 换成 _）：
# NEWSCLAW_PROVIDER_MY_CUSTOM_PROVIDER_API_KEY=
# NEWSCLAW_PROVIDER_MY_CUSTOM_PROVIDER_BASE_URL=https://...

# ==================== DeepSeek Harness（可选） ====================
DSH_JSONRPC_AGENT=
DSH_CORDIS_CONFIG=
DSH_CWD=
DSH_MANIFEST_URL=
DSH_GITHUB_RELEASE_URL=https://api.github.com/repos/deepseek-ai/deepseek-harness/releases/latest
DSH_INSTALL_ROOT=/app/data/runtimes/deepseek-harness

# ==================== 公众号草稿箱 ====================
# GzhPublishTool 使用这两个值；默认只创建草稿，不直接群发。
WEIXINOA_APP_ID=
WEIXINOA_APP_SECRET=

# ==================== 国内 IM 入站/通知 ====================
# 先在「渠道」创建并启用对应类型；以下 Key 在适配器启动时覆盖 config_json。
# 飞书 WebSocket 需要 FEISHU_APP_ID + FEISHU_APP_SECRET；钉钉 Stream 需要
# DINGTALK_CLIENT_ID + DINGTALK_CLIENT_SECRET，robot_code 仅在主动推送/媒体场景通常需要。
# 企业微信需要 WECOM_BOT_ID + WECOM_SECRET（或 WECOM_BOT_SECRET）。

# 飞书（WebSocket 默认，无需公网回调）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_CONNECTION_MODE=websocket
FEISHU_DOMAIN=feishu

# 钉钉（Stream 默认）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_CONNECTION_MODE=stream
DINGTALK_MESSAGE_TYPE=markdown
DINGTALK_CARD_TEMPLATE_ID=

# 企业微信智能机器人（WebSocket）
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_BOT_SECRET=
WECOM_WELCOME_TEXT=

# 微信个人号 iLink Bot（可选）
WEIXIN_BOT_TOKEN=
WECHAT_BOT_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# QQ Bot（保留兼容入口；主线默认不启用）
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_MARKDOWN_ENABLED=true
QQ_MAX_RECONNECT_ATTEMPTS=100
QQ_BIND_PORTAL_HOST=q.qq.com

# ==================== OpenAI OAuth / 飞书 SSO（可选） ====================
NEWSCLAW_OAUTH_OPENAI_DEPLOYMENT_MODE=
NEWSCLAW_OAUTH_OPENAI_CALLBACK_BIND_HOST=0.0.0.0
SSO_ENABLED=false
SSO_LINK_ONLY=false
SSO_DEFAULT_ROLE=user
SSO_FEISHU_ENABLED=false
SSO_FEISHU_APP_ID=
SSO_FEISHU_APP_SECRET=
SSO_FEISHU_DOMAIN=feishu
SSO_FEISHU_REDIRECT_URI=

# ==================== 浏览器与网络安全 ====================
# Docker 镜像自带 Chromium，以下均可留默认值。
NEWSCLAW_BROWSER_CDP_URL=
NEWSCLAW_BROWSER_CHROME_PATH=
NEWSCLAW_BROWSER_CHANNEL=
PLAYWRIGHT_ALLOW_PRIVATE_NETWORK=false
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=false
PLAYWRIGHT_DEFAULT_TIMEOUT_SECONDS=30
PLAYWRIGHT_NAVIGATION_TIMEOUT_SECONDS=30
PLAYWRIGHT_SNAPSHOT_MAX_LENGTH=20000

# ==================== Wiki / 证据归档 ====================
# 目录必须同时挂载到 newsclaw-server 容器，留空则禁止目录扫描。
NEWSCLAW_WIKI_ALLOWED_SOURCE_ROOTS=
NEWSCLAW_WIKI_WATCHER_ENABLED=false
NEWSCLAW_WIKI_WATCHER_INTERVAL_MS=300000

# ==================== Skill 自进化与能力运营 ====================
# 生产环境建议显式开启 reflection/routine 前先审查脱敏与审批策略。
NEWSCLAW_SKILL_REFLECTION_ENABLED=false
NEWSCLAW_SKILL_REFLECTION_AUTO_APPLY=false
NEWSCLAW_SKILL_REFLECTION_TURN_INTERVAL=8
NEWSCLAW_SKILL_REFLECTION_MIN_ASSISTANT_TURNS=2
NEWSCLAW_SKILL_REFLECTION_MAX_MESSAGES=24
NEWSCLAW_SKILL_REFLECTION_COOLDOWN_MINUTES=30
NEWSCLAW_SKILL_REFLECTION_MAX_ACTIONS=3
NEWSCLAW_SKILL_REFLECTION_CATALOG_BUDGET=8000
NEWSCLAW_SKILL_REFLECTION_MODEL_ID=
NEWSCLAW_SKILL_ROUTINE_ENABLED=false
NEWSCLAW_SKILL_ROUTINE_CRON="0 0 3 * * *"
NEWSCLAW_SKILL_ROUTINE_LOOKBACK_DAYS=30
NEWSCLAW_SKILL_ROUTINE_SIMILARITY=0.62
NEWSCLAW_SKILL_ROUTINE_MIN_OCCURRENCES=3
NEWSCLAW_SKILL_ROUTINE_MIN_DISTINCT_DAYS=3
NEWSCLAW_SKILL_ROUTINE_MIN_OPENER_CHARS=8
NEWSCLAW_SKILL_ROUTINE_MAX_OPENER_CHARS=400
NEWSCLAW_SKILL_ROUTINE_MAX_SAMPLES=8
NEWSCLAW_SKILL_ROUTINE_MAX_PROMOTIONS=2
NEWSCLAW_SKILL_ROUTINE_MAX_CONVERSATIONS=1000
NEWSCLAW_SKILL_ROUTINE_TRANSCRIPT_MESSAGES=12
NEWSCLAW_SKILL_ROUTINE_TRANSCRIPT_TRUNCATE=800
NEWSCLAW_SKILL_ROUTINE_MODEL_ID=
# true 只会自动生成待审 Skill proposal，不会直接写入生产 Skill。
NEWSCLAW_SKILL_ROUTINE_AUTO_PROMOTE=false
NEWSCLAW_SKILL_WORKSPACE_ROOT=/app/data/skills
NEWSCLAW_SKILL_LOAD_SKILL_TOOL_ENABLED=true
NEWSCLAW_SKILL_UPLOAD_MAX_ENTRY_SIZE_MB=1
NEWSCLAW_SKILL_UPLOAD_MAX_TOTAL_SIZE_MB=50
NEWSCLAW_SKILL_CURATOR_BACKUP_ENABLED=true
NEWSCLAW_SKILL_CURATOR_BACKUP_KEEP=5

# ==================== 长期记忆治理 ====================
# 长期记忆不是新闻正文缓存。每次写入都需保留来源指针并经过 token 预算、冲突版本和
# AI 动态证据拦截；事件事实与完整引用请保存在 AI 动态事件/Wiki 证据层。
NEWSCLAW_MEMORY_GOVERNANCE_ENABLED=true
# 单条候选记忆的估算 token 上限；中文按接近 1 字符/Token 保守估算。
NEWSCLAW_MEMORY_WRITE_MAX_TOKENS=320
# 同一 workspace + Agent + owner 的活跃长期记忆估算 token 总预算，0 表示不限制。
NEWSCLAW_MEMORY_LONG_TERM_TOKEN_BUDGET=2400
# true 时拒绝 AI 新闻正文、证据原文等文章形态内容进入长期记忆。
NEWSCLAW_MEMORY_REJECT_NEWS_BODY=true
# true 时要求 conversation:/ai-news:/wiki:/显式上下文等可追溯来源指针。
NEWSCLAW_MEMORY_REQUIRE_SOURCE_REF=true

# ==================== Python / 构建加速（可选） ====================
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
MAVEN_FLAGS=

# ==================== 非主线兼容 Key（按需） ====================
# 内容图片/视频工具仍可从系统设置使用这些变量；AI 动态主线不要求。
FAL_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
RUNWAY_API_KEY=
MINIMAX_REGION=global
