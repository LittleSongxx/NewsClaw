{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsclaw.local/schemas/ai-news-domain-gold-blind-worksheet-v1.json",
  "title": "NewsClaw AI-news blind independent annotation worksheet",
  "description": "Gold-blind worksheet. The allow-list deliberately excludes pool-system identity, rankings, NewsClaw event/cluster identity, scores and predicted labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worksheetType",
    "worksheetStatus",
    "campaignId",
    "sourcePoolSha256",
    "reviewer",
    "cases"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "worksheetType": {"const": "blind-independent-domain-gold-review"},
    "worksheetStatus": {"enum": ["DRAFT", "COMPLETE"]},
    "campaignId": {"type": "string", "minLength": 1},
    "sourcePoolSha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"worksheetStatus": {"const": "COMPLETE"}},
        "required": ["worksheetStatus"]
      },
      "then": {
        "properties": {
          "reviewer": {"$ref": "#/$defs/completedReviewer"},
          "cases": {
            "items": {
              "properties": {
                "annotation": {"$ref": "#/$defs/completedAnnotation"}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "reviewerId",
        "startedAt",
        "completedAt",
        "attestsNoSystemPredictionExposure",
        "attestsNoOtherReviewerExposure",
        "attestsIndependentHumanWork"
      ],
      "properties": {
        "slot": {"enum": ["reviewer-a", "reviewer-b"]},
        "reviewerId": {"type": "string"},
        "startedAt": {
          "oneOf": [{"$ref": "#/$defs/utcInstant"}, {"type": "null"}]
        },
        "completedAt": {
          "oneOf": [{"$ref": "#/$defs/utcInstant"}, {"type": "null"}]
        },
        "attestsNoSystemPredictionExposure": {"type": "boolean"},
        "attestsNoOtherReviewerExposure": {"type": "boolean"},
        "attestsIndependentHumanWork": {"type": "boolean"}
      }
    },
    "completedReviewer": {
      "allOf": [
        {"$ref": "#/$defs/reviewer"},
        {
          "properties": {
            "reviewerId": {"type": "string", "minLength": 1},
            "startedAt": {"$ref": "#/$defs/utcInstant"},
            "completedAt": {"$ref": "#/$defs/utcInstant"},
            "attestsNoSystemPredictionExposure": {"const": true},
            "attestsNoOtherReviewerExposure": {"const": true},
            "attestsIndependentHumanWork": {"const": true}
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "caseKind", "reviewMaterial", "annotation"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "caseKind": {"enum": ["source_observation", "system_output"]},
        "reviewMaterial": {"$ref": "#/$defs/reviewMaterial"},
        "annotation": {"$ref": "#/$defs/annotation"}
      }
    },
    "reviewMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "observedAt",
        "publisher",
        "sourceFamily",
        "language",
        "url",
        "canonicalUrl",
        "title",
        "publishedAt",
        "mainContent",
        "claims",
        "quotes"
      ],
      "properties": {
        "itemId": {"type": "string", "minLength": 1},
        "observedAt": {"$ref": "#/$defs/utcInstant"},
        "publisher": {"type": "string", "minLength": 1},
        "sourceFamily": {"enum": ["official", "media", "community"]},
        "language": {"type": "string", "minLength": 2},
        "url": {"type": "string", "format": "uri"},
        "canonicalUrl": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "publishedAt": {
          "oneOf": [{"$ref": "#/$defs/utcInstant"}, {"type": "null"}]
        },
        "publishedAtRaw": {"type": ["string", "null"]},
        "mainContent": {"type": ["string", "null"]},
        "contentSha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/claim"}
        },
        "quotes": {
          "type": "array",
          "items": {"$ref": "#/$defs/quote"}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "text"],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quoteId", "sourceUrl", "text"],
      "properties": {
        "quoteId": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "format": "uri"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevance",
        "newsType",
        "reviewerEventId",
        "novelty",
        "firstPublishedAt",
        "titleCorrect",
        "mainContentQuality",
        "sourceTier",
        "claimQuoteRelations",
        "issueCodes",
        "notes"
      ],
      "properties": {
        "relevance": {"enum": ["relevant", "not_relevant", "unknown", null]},
        "newsType": {
          "enum": [
            "model",
            "product",
            "open_source",
            "security",
            "infrastructure",
            "partnership",
            "funding",
            "robotics",
            "industry",
            "policy",
            "not_news",
            "unknown",
            null
          ]
        },
        "reviewerEventId": {"type": ["string", "null"]},
        "novelty": {"enum": ["first_story", "new_source", "material_update", "duplicate", "unknown", null]},
        "firstPublishedAt": {
          "oneOf": [{"$ref": "#/$defs/utcInstant"}, {"type": "null"}]
        },
        "titleCorrect": {"type": ["boolean", "null"]},
        "mainContentQuality": {"enum": ["complete", "partial", "boilerplate", "unavailable", "unknown", null]},
        "sourceTier": {"enum": ["official", "media", "community", "unknown", null]},
        "claimQuoteRelations": {
          "type": "array",
          "items": {"$ref": "#/$defs/claimQuoteRelation"}
        },
        "issueCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ambiguous-event-boundary",
              "ambiguous-publication-time",
              "bad-language-or-translation",
              "insufficient-content",
              "source-tier-ambiguity",
              "claim-or-quote-ambiguity",
              "rights-or-retention-concern",
              "other"
            ]
          }
        },
        "notes": {"type": "string"}
      }
    },
    "completedAnnotation": {
      "allOf": [
        {"$ref": "#/$defs/annotation"},
        {
          "properties": {
            "relevance": {"enum": ["relevant", "not_relevant", "unknown"]},
            "newsType": {
              "enum": [
                "model",
                "product",
                "open_source",
                "security",
                "infrastructure",
                "partnership",
                "funding",
                "robotics",
                "industry",
                "policy",
                "not_news",
                "unknown"
              ]
            },
            "novelty": {"enum": ["first_story", "new_source", "material_update", "duplicate", "unknown"]},
            "mainContentQuality": {"enum": ["complete", "partial", "boilerplate", "unavailable", "unknown"]},
            "sourceTier": {"enum": ["official", "media", "community", "unknown"]}
          }
        }
      ]
    },
    "claimQuoteRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "quoteId", "relation"],
      "properties": {
        "claimId": {"type": "string", "minLength": 1},
        "quoteId": {"type": "string", "minLength": 1},
        "relation": {"enum": ["entails", "partial", "contradicts", "unrelated", "hedged", "unknown"]}
      }
    }
  }
}
